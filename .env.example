# Bot tokeni (@BotFather)
BOT_TOKEN=

# Dars videolari turgan kanal/guruh ID. Bot unda a'zo bo'lishi kerak.
SOURCE_CHAT_ID=

# Asosiy adminlar telegram ID (vergul bilan).
# Bular paneldan o'chirilmaydi. Qolganlari panelning "👮 Adminlar" bo'limidan qo'shiladi.
ADMINS=

# PostgreSQL
DB_URL=postgresql+asyncpg://postgres:PAROL@localhost:5432/menu_builder_db

# Vaqt zonasi
TIMEZONE=Asia/Tashkent

# Excel har kuni qaysi vaqtda yangilansin
EXPORT_HOUR=0
EXPORT_MINUTE=5
